<Window x:Class="LiwaPlayer.SpotifyImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spotify Listesi İçe Aktar"
        Height="560"
        Width="520"
        MinHeight="420"
        MinWidth="440"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Closing="Window_Closing">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Spotify liste veya albüm bağlantısını yapıştırın"
                   Style="{StaticResource PanelTitle}"
                   Margin="2,0,0,8"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="txtUrl"
                     Style="{StaticResource SearchBox}"
                     KeyDown="txtUrl_KeyDown"/>

            <Button x:Name="btnImport"
                    Grid.Column="1"
                    Style="{StaticResource TextButton}"
                    Content="İçe Aktar"
                    Margin="8,0,0,0"
                    Click="btnImport_Click"/>
        </Grid>

        <TextBlock Grid.Row="2"
                   Style="{StaticResource MutedText}"
                   FontSize="11"
                   Margin="2,8,0,0"
                   TextWrapping="Wrap"
                   Text="Örnek: https://open.spotify.com/playlist/... veya .../album/... — Yalnızca herkese açık içerik okunabilir. Her şarkının YouTube karşılığı otomatik bulunur."/>

        <ProgressBar x:Name="progress"
                     Grid.Row="3"
                     Style="{StaticResource ModernProgress}"
                     Margin="0,14,0,0"
                     Minimum="0"
                     Value="0"/>

        <TextBlock x:Name="txtProgress"
                   Grid.Row="4"
                   Style="{StaticResource MutedText}"
                   FontSize="12"
                   Margin="2,8,0,10"
                   Text="Hazır."
                   TextTrimming="CharacterEllipsis"/>

        <Border Grid.Row="5" Style="{StaticResource Panel}">
            <ListView x:Name="lstLog"
                      Style="{StaticResource ModernList}"
                      Margin="6">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>

</Window>
