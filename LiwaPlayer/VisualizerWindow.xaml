<Window x:Class="LiwaPlayer.VisualizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LiwaPlayer Görselleştirici"
        Height="540"
        Width="860"
        MinHeight="360"
        MinWidth="520"
        Background="#0A0A10"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner"
        KeyDown="Window_KeyDown"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseDoubleClick="Window_MouseDoubleClick"
        SizeChanged="Window_SizeChanged">

    <Grid>
        <!-- Çubukların çizildiği yüzey -->
        <Canvas x:Name="canvas" ClipToBounds="True"/>

        <!-- Kapak + şarkı bilgisi -->
        <StackPanel x:Name="infoPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <Grid Width="220" Height="220" HorizontalAlignment="Center">
                <Border Background="{StaticResource Surface2Brush}"
                        CornerRadius="16">
                    <TextBlock Text="&#xE8D6;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="64"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <Border CornerRadius="16">
                    <Border.Background>
                        <ImageBrush x:Name="brushArt" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
            </Grid>

            <TextBlock x:Name="txtVisTitle"
                       Text=""
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="White"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="600"
                       Margin="0,18,0,2"/>

            <TextBlock x:Name="txtVisArtist"
                       Text=""
                       FontSize="14"
                       Foreground="{StaticResource MutedBrush}"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="600"/>
        </StackPanel>

        <TextBlock Text="Tık: stil değiştir   •   Çift tık: tam ekran   •   Esc: kapat"
                   Foreground="#55FFFFFF"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,10"/>
    </Grid>

</Window>
