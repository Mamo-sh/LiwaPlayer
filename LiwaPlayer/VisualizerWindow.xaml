<Window x:Class="LiwaPlayer.VisualizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LiwaPlayer Görselleştirici"
        Height="560"
        Width="880"
        MinHeight="380"
        MinWidth="560"
        Background="#0A0A10"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner"
        KeyDown="Window_KeyDown"
        SizeChanged="Window_SizeChanged">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Sahne: video veya ışık stilleri -->
        <Grid x:Name="stage"
              Background="Transparent"
              MouseLeftButtonUp="stage_MouseLeftButtonUp"
              MouseLeftButtonDown="stage_MouseLeftButtonDown">

            <!-- Klip modu: VideoView kodda oluşturulur, çıkışta tamamen yok edilir
                 (yaşamaya devam ederse WPF o bölgeyi yeniden çizemiyor) -->
            <ContentControl x:Name="videoHost" Visibility="Collapsed"/>

            <!-- Çubukların çizildiği yüzey -->
            <Canvas x:Name="canvas" ClipToBounds="True"/>

            <!-- Kapak + şarkı bilgisi -->
            <StackPanel x:Name="infoPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <Grid Width="220" Height="220" HorizontalAlignment="Center">
                    <Border Background="{StaticResource Surface2Brush}"
                            CornerRadius="16">
                        <TextBlock Text="&#xE8D6;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="64"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <Border CornerRadius="16">
                        <Border.Background>
                            <ImageBrush x:Name="brushArt" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                </Grid>

                <TextBlock x:Name="txtVisTitle"
                           Text=""
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="White"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="600"
                           Margin="0,18,0,2"/>

                <TextBlock x:Name="txtVisArtist"
                           Text=""
                           FontSize="14"
                           Foreground="{StaticResource MutedBrush}"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="600"/>
            </StackPanel>
        </Grid>

        <!-- Kontrol çubuğu: videonun DIŞINDA, her zaman tıklanabilir -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="txtBarTitle"
                           Text=""
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="2,0,10,0"
                           TextTrimming="CharacterEllipsis"/>

                <Button x:Name="btnStyle"
                        Grid.Column="1"
                        Style="{StaticResource SecondaryTextButton}"
                        Content="Stil"
                        ToolTip="Işık stilini değiştir (çubuk / ayna / halka)"
                        Click="btnStyle_Click"/>

                <Button x:Name="btnClip"
                        Grid.Column="2"
                        Style="{StaticResource SecondaryTextButton}"
                        Content="Klip"
                        Margin="6,0,0,0"
                        ToolTip="Şarkının klibini aç/kapat"
                        Click="btnClip_Click"/>

                <Button Grid.Column="3"
                        Style="{StaticResource SecondaryTextButton}"
                        Content="Tam Ekran"
                        Margin="6,0,0,0"
                        ToolTip="Tam ekran (F11)"
                        Click="btnFull_Click"/>

                <Button Grid.Column="4"
                        Style="{StaticResource SecondaryTextButton}"
                        Content="Kapat"
                        Margin="6,0,0,0"
                        ToolTip="Görselleştiriciyi kapat (Esc)"
                        Click="btnCloseVis_Click"/>
            </Grid>
        </Border>
    </Grid>

</Window>
