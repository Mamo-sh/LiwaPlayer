<Window x:Class="LiwaPlayer.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="YouTube Hesabıyla Giriş"
        Height="680"
        Width="520"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource SurfaceBrush}" Padding="14,10">
            <TextBlock Text="Google hesabınla giriş yap. Giriş tamamlanınca pencere kendiliğinden kapanır."
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"/>
        </Border>

        <wv2:WebView2 x:Name="webView" Grid.Row="1"/>

        <TextBlock x:Name="txtLoading"
                   Grid.Row="1"
                   Text="Yükleniyor..."
                   Foreground="{StaticResource MutedBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
    </Grid>

</Window>
