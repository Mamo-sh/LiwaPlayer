<Window x:Class="LiwaPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LiwaPlayer"
        Height="620"
        Width="1000"
        MinHeight="480"
        MinWidth="840"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="12">

        <Grid.LayoutTransform>
            <ScaleTransform x:Name="uiScale" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Üst İçerik: Playlist + YouTube Arama ═══ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- Çalma Listesi -->
            <Border Style="{StaticResource Panel}">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="2,0,2,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="&#xE90B;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <TextBlock x:Name="txtPlaylistName"
                                   Grid.Column="1"
                                   Style="{StaticResource PanelTitle}"
                                   Text="Müzik"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="220"/>

                        <TextBlock x:Name="txtCount"
                                   Grid.Column="2"
                                   Style="{StaticResource MutedText}"
                                   Margin="10,0,0,0"
                                   FontSize="12"
                                   Text=""/>

                        <Button Grid.Column="3"
                                Style="{StaticResource IconButton}"
                                Content="&#xE8F1;"
                                ToolTip="Kayıtlı listeler: yeni oluştur, aç, sil"
                                Click="btnManager_Click"/>

                        <Button Grid.Column="4"
                                Style="{StaticResource IconButton}"
                                Content="&#xE93C;"
                                Foreground="#1DB954"
                                ToolTip="Spotify listesi veya albümü içe aktar (şarkıların YouTube karşılıkları bulunur)"
                                Click="btnSpotify_Click"/>

                        <Button Grid.Column="5"
                                Style="{StaticResource IconButton}"
                                Content="&#xE786;"
                                Foreground="#FF4444"
                                ToolTip="YouTube listesi veya albümü içe aktar"
                                Click="btnYouTubeImport_Click"/>

                        <Button Grid.Column="6"
                                Style="{StaticResource IconButton}"
                                Content="&#xE8E5;"
                                ToolTip="Bilgisayardan müzik dosyası ekle"
                                Click="btnAddFiles_Click"/>

                        <Button Grid.Column="7"
                                Style="{StaticResource IconButton}"
                                Content="&#xE8DE;"
                                ToolTip="Seçili şarkıyı başka listeye taşı"
                                Click="btnMoveSong_Click"/>

                        <Button Grid.Column="8"
                                Style="{StaticResource IconButton}"
                                Content="&#xE74D;"
                                ToolTip="Seçili şarkıyı listeden çıkar (Del)"
                                Click="btnDelete_Click"/>

                        <Button Grid.Column="9"
                                Style="{StaticResource IconButton}"
                                Content="&#xE894;"
                                ToolTip="Bu listeyi temizle"
                                Click="btnClear_Click"/>
                    </Grid>

                    <ListView x:Name="lstPlaylist"
                              Grid.Row="1"
                              Style="{StaticResource ModernList}"
                              MouseDoubleClick="lstPlaylist_MouseDoubleClick">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="icoPlaying"
                                               Text="&#xE767;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               Foreground="{StaticResource AccentBrush}"
                                               VerticalAlignment="Center"
                                               Visibility="Hidden"/>

                                    <TextBlock x:Name="txtTitle"
                                               Grid.Column="1"
                                               Text="{Binding Title}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Artist}"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding DurationText}"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="12"
                                               VerticalAlignment="Center"/>

                                    <Border Grid.Column="4"
                                            Background="{StaticResource Surface3Brush}"
                                            CornerRadius="4"
                                            Padding="5,2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SourceText}"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="10"/>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="icoPlaying" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="txtTitle" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                        <Setter TargetName="txtTitle" Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock x:Name="txtPlaylistHint"
                               Grid.Row="1"
                               Text="Liste boş.&#10;&#10;Sağdaki kutudan YouTube'da arama yapıp&#10;şarkı ekleyebilir veya üstteki &#xE8E5; butonuyla&#10;bilgisayardan dosya ekleyebilirsiniz."
                               Foreground="{StaticResource MutedBrush}"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- YouTube Arama -->
            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="2,0,2,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Image Source="/Assets/youtube-logo.png"
                               Height="20"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="8,0">
                            <RadioButton x:Name="rbSearchVideo"
                                         Style="{StaticResource TabButton}"
                                         Content="Video"
                                         IsChecked="True"/>
                            <RadioButton x:Name="rbSearchMusic"
                                         Style="{StaticResource TabButton}"
                                         Content="Müzik"
                                         Margin="2,0,0,0"/>
                        </StackPanel>

                        <Button x:Name="btnAccount"
                                Grid.Column="3"
                                Style="{StaticResource IconButton}"
                                Content="&#xE77B;"
                                ToolTip="YouTube hesabıyla giriş yap (Premium: reklamsız + kendi listelerin)"
                                Click="btnAccount_Click"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="txtSearch"
                                 Style="{StaticResource SearchBox}"
                                 KeyDown="txtSearch_KeyDown"/>

                        <Button x:Name="btnSearch"
                                Grid.Column="1"
                                Style="{StaticResource IconButton}"
                                Content="&#xE721;"
                                Margin="6,0,0,0"
                                ToolTip="Ara (Enter)"
                                Click="btnSearch_Click"/>
                    </Grid>

                    <TextBlock x:Name="txtRecoTitle"
                               Grid.Row="2"
                               Text="✨ Sana özel öneriler"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="4,0,0,8"
                               Visibility="Collapsed"/>

                    <ListView x:Name="lstResults"
                              Grid.Row="3"
                              Style="{StaticResource ModernList}"
                              MouseDoubleClick="lstResults_MouseDoubleClick">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Kapak resmi (yüklenemezse nota simgesi görünür) -->
                                    <Grid Width="64" Height="36" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Border Background="{StaticResource Surface3Brush}" CornerRadius="6">
                                            <TextBlock Text="&#xE8D6;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="14"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <Border CornerRadius="6">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding ThumbnailUrl}"
                                                            Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding Title}"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="13"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding Author}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="180"/>
                                            <TextBlock Text=" • "
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="11"/>
                                            <TextBlock Text="{Binding DurationText}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Style="{StaticResource IconButton}"
                                                Width="30" Height="30"
                                                FontSize="13"
                                                Content="&#xE710;"
                                                ToolTip="Listeye ekle"
                                                Click="btnAddResult_Click"/>
                                        <Button Style="{StaticResource IconButton}"
                                                Width="30" Height="30"
                                                FontSize="13"
                                                Content="&#xE768;"
                                                ToolTip="Ekle ve hemen çal"
                                                Click="btnPlayResult_Click"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock x:Name="txtSearchHint"
                               Grid.Row="3"
                               Text="Şarkı veya sanatçı adı yazıp Enter'a basın.&#10;&#10;İpucu: Bir YouTube liste bağlantısı yapıştırırsan&#10;tamamı yeni bir listeye aktarılır."
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="20"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ Alt Oynatıcı Çubuğu ═══ -->
        <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,12,0,0">
            <Grid Margin="16,10,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- İlerleme -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="txtCurrent"
                               Style="{StaticResource MutedText}"
                               FontSize="11"
                               Width="44"
                               Text="00:00"/>

                    <Slider x:Name="sliderPosition"
                            Grid.Column="1"
                            Style="{StaticResource ModernSlider}"
                            Margin="8,0"
                            Minimum="0"
                            Maximum="100"/>

                    <TextBlock x:Name="txtDuration"
                               Grid.Column="2"
                               Style="{StaticResource MutedText}"
                               FontSize="11"
                               Width="44"
                               TextAlignment="Right"
                               Text="00:00"/>
                </Grid>

                <!-- Kontroller -->
                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Çalan şarkı -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="coverBox"
                                Background="{StaticResource Surface3Brush}"
                                CornerRadius="8"
                                Width="40" Height="40"
                                Margin="0,0,10,0"
                                Cursor="Hand"
                                ToolTip="Görselleştiriciyi aç"
                                MouseLeftButtonUp="coverBox_MouseLeftButtonUp">
                            <Grid>
                                <TextBlock Text="&#xE8D6;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <Border CornerRadius="8">
                                    <Border.Background>
                                        <ImageBrush x:Name="brushCover" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center" MaxWidth="260">
                            <TextBlock x:Name="txtSong"
                                       Text="Şarkı seçilmedi"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="{StaticResource TextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="txtStatus"
                                       Style="{StaticResource MutedText}"
                                       FontSize="11"
                                       Text="Hazır"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Oynatma butonları -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}"
                                Content="&#xE892;"
                                ToolTip="Önceki"
                                Click="btnPrevious_Click"/>

                        <Button x:Name="btnPlayPause"
                                Style="{StaticResource PlayButton}"
                                Content="&#xE768;"
                                Margin="10,0"
                                ToolTip="Oynat / Duraklat (Boşluk)"
                                Click="btnPlayPause_Click"/>

                        <Button Style="{StaticResource IconButton}"
                                Content="&#xE893;"
                                ToolTip="Sonraki"
                                Click="btnNext_Click"/>
                    </StackPanel>

                    <!-- Karıştır / Tekrarla / Ses -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                        <ToggleButton x:Name="btnShuffle"
                                      Style="{StaticResource ToggleIconButton}"
                                      Content="&#xE8B1;"
                                      ToolTip="Karıştır"/>

                        <ToggleButton x:Name="btnRepeat"
                                      Style="{StaticResource ToggleIconButton}"
                                      Content="&#xE8EE;"
                                      Margin="2,0,10,0"
                                      ToolTip="Liste bitince başa dön"/>

                        <TextBlock Text="&#xE767;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>

                        <Slider x:Name="sliderVolume"
                                Style="{StaticResource ModernSlider}"
                                Width="110"
                                Minimum="0"
                                Maximum="100"
                                Value="80"
                                ValueChanged="sliderVolume_ValueChanged"/>

                        <TextBlock x:Name="txtVolume"
                                   Style="{StaticResource MutedText}"
                                   FontSize="11"
                                   Width="32"
                                   TextAlignment="Right"
                                   Text="%80"/>

                        <Border Width="1"
                                Background="{StaticResource LineBrush}"
                                Margin="10,6"/>

                        <Button x:Name="btnZoomOut"
                                Style="{StaticResource IconButton}"
                                FontSize="13"
                                Content="&#xE71F;"
                                ToolTip="Arayüzü küçült (Ctrl + tekerlek)"
                                Click="btnZoomOut_Click"/>

                        <Button x:Name="btnZoomIn"
                                Style="{StaticResource IconButton}"
                                FontSize="13"
                                Content="&#xE8A3;"
                                ToolTip="Arayüzü büyüt (Ctrl + tekerlek)"
                                Click="btnZoomIn_Click"/>

                        <Button x:Name="btnSettings"
                                Style="{StaticResource IconButton}"
                                FontSize="14"
                                Content="&#xE713;"
                                ToolTip="Optimizasyon ayarları"
                                Click="btnSettings_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

    </Grid>

</Window>
