<Window x:Class="LiwaPlayer.PlaylistManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kayıtlı Listeler"
        Height="520"
        Width="470"
        MinHeight="380"
        MinWidth="400"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Yeni liste oluşturma -->
        <TextBlock Text="Yeni liste oluştur"
                   Style="{StaticResource PanelTitle}"
                   Margin="2,0,0,8"/>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="txtNewName"
                     Style="{StaticResource SearchBox}"
                     KeyDown="txtNewName_KeyDown"/>

            <Button x:Name="btnCreate"
                    Grid.Column="1"
                    Style="{StaticResource TextButton}"
                    Content="Oluştur"
                    Margin="8,0,0,0"
                    Click="btnCreate_Click"/>
        </Grid>

        <!-- Kayıtlı listeler -->
        <TextBlock Grid.Row="2"
                   Text="Kayıtlı listeler"
                   Style="{StaticResource PanelTitle}"
                   Margin="2,0,0,8"/>

        <Border Grid.Row="3"
                Style="{StaticResource Panel}">
            <ListView x:Name="lstPlaylists"
                      Style="{StaticResource ModernList}"
                      Margin="6"
                      MouseDoubleClick="lstPlaylists_MouseDoubleClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Margin="2,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="220"/>
                                    <TextBlock x:Name="tbActive"
                                               Text="  •  şu an açık"
                                               FontSize="11"
                                               Foreground="{StaticResource AccentBrush}"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                                <TextBlock Foreground="{StaticResource MutedBrush}"
                                           FontSize="11"
                                           Margin="0,2,0,0">
                                    <Run Text="{Binding Songs.Count, Mode=OneWay}"/><Run Text=" şarkı"/>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryTextButton}"
                                        Content="Aç"
                                        ToolTip="Bu listeyi oynatıcıda aç"
                                        Click="btnOpen_Click"/>
                                <Button Style="{StaticResource IconButton}"
                                        Content="&#xE74D;"
                                        Margin="4,0,0,0"
                                        ToolTip="Listeyi sil"
                                        Click="btnDeletePlaylist_Click"/>
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="tbActive" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <TextBlock x:Name="txtMgrStatus"
                   Grid.Row="4"
                   Style="{StaticResource MutedText}"
                   FontSize="11"
                   Margin="2,10,0,0"
                   Text="Bir listeye çift tıklayarak da açabilirsiniz."/>
    </Grid>

</Window>
